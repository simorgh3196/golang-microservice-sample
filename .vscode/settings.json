{
    "[go]": {
        "editor.defaultFormatter": "golang.go",
        "editor.insertSpaces": false,
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "[go.mod]": {
        "editor.defaultFormatter": "golang.go",
        "editor.insertSpaces": false,
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "[go.work]": {
        "editor.defaultFormatter": "golang.go",
        "editor.insertSpaces": false,
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "[proto]": {
        "editor.defaultFormatter": "DrBlury.protobuf-vsc"
    },
    "[protobuf]": {
        "editor.defaultFormatter": "DrBlury.protobuf-vsc"
    },
    // Formatting
    "protobuf.formatOnSave": true,
    "protobuf.formatter.alignFields": true,
    // Import search paths
    "protobuf.includes": [
        "${workspaceFolder}/proto"
    ],
    // Linting (Buf) on save
    "protobuf.externalLinter.enabled": true,
    "protobuf.externalLinter.linter": "buf",
    "protobuf.externalLinter.runOnSave": true,
    // IntelliSense/hover polish
    "protobuf.completion.autoImport": true,
    "protobuf.hover.showDocumentation": true,
    "go.lintTool": "golangci-lint",
    "go.lintOnSave": "package",
    "go.lintFlags": [
        "--fast"
    ],
    "go.alternateTools": {
        "dlv": "${env:HOME}/.local/share/mise/shims/dlv",
        "go": "${env:HOME}/.local/share/mise/shims/go",
        "golangci-lint": "${env:HOME}/.local/share/mise/shims/golangci-lint",
        "gopls": "${env:HOME}/.local/share/mise/shims/gopls",
        "impl": "${env:HOME}/.local/share/mise/shims/impl"
    }
}
